# Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=decision_engine

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production

# LLM API Keys
# ANTHROPIC_API_KEY is required for Claude-powered analysis
# Get your key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude Model (optional, defaults to claude-3-5-sonnet-20241022)
# Options: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Gemini API Key (optional fallback if Claude fails)
# Get your key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here

# Gemini Model (optional, defaults to gemini-1.5-flash)
# Available stable models: gemini-1.5-pro, gemini-1.5-flash, gemini-1.0-pro, gemini-pro
# NOTE: Use exact model names as shown, lowercase with hyphens, no spaces
GEMINI_MODEL=gemini-1.5-flash

# CORS
CORS_ORIGIN=http://localhost:3000
